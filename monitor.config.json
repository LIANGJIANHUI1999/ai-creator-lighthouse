{
  "schemaVersion": 1,
  "repository": "LIANGJIANHUI1999/ai-creator-lighthouse",
  "runs": 3,
  "retryCount": 1,
  "reportRetentionDays": 30,
  "chromeVersion": "157.0.8103.50",
  "environments": {
    "production": { "labelKey": "production", "origin": "https://vidma.ai" },
    "staging": { "labelKey": "staging", "origin": "https://vidmaeditor-ios.web.app" }
  },
  "profile": {
    "id": "desktop-v2-native-ua",
    "formFactor": "desktop",
    "emulatedUserAgent": false,
    "screenEmulation": { "mobile": false, "width": 1350, "height": 940, "deviceScaleFactor": 1, "disabled": false },
    "throttlingMethod": "simulate",
    "throttling": { "rttMs": 40, "throughputKbps": 10240, "cpuSlowdownMultiplier": 1, "requestLatencyMs": 0, "downloadThroughputKbps": 0, "uploadThroughputKbps": 0 },
    "disableStorageReset": false,
    "maxWaitForLoad": 45000
  },
  "mobileProfile": {
    "id": "mobile-v1-slow4g",
    "formFactor": "mobile",
    "emulatedUserAgent": true,
    "screenEmulation": { "mobile": true, "width": 412, "height": 823, "deviceScaleFactor": 1.75, "disabled": false },
    "throttlingMethod": "simulate",
    "throttling": { "rttMs": 150, "throughputKbps": 1638.4, "cpuSlowdownMultiplier": 4, "requestLatencyMs": 562.5, "downloadThroughputKbps": 1474.56, "uploadThroughputKbps": 675 },
    "disableStorageReset": false,
    "maxWaitForLoad": 45000
  },
  "routes": [
    { "id": "landing", "labelKey": "landing", "path": "/" },
    { "id": "home", "labelKey": "home", "path": "/en/home/" },
    { "id": "subscribe", "labelKey": "subscribe", "path": "/en/subscribe/" },
    { "id": "ai-video", "labelKey": "aiVideo", "path": "/en/ai-video/" },
    { "id": "video-create", "labelKey": "videoCreate", "path": "/en/video-create/?mode=text" },
    { "id": "image-create", "labelKey": "imageCreate", "path": "/en/image-create/" },
    { "id": "tools", "labelKey": "tools", "path": "/en/tools/" },
    { "id": "clothes-transfer", "labelKey": "clothesTransfer", "path": "/en/tools/clothes-transfer/" },
    { "id": "editor", "labelKey": "editor", "path": "/en/editor/" },
    { "id": "ai-ads-en", "labelKey": "aiAdsEn", "path": "/en/ai-ads/" },
    {"id": "asset", "labelKey": "asset", "path": "/en/asset/", "seoPolicy": "noindex"},
    {"id": "ai-sprite", "labelKey": "aiSprite", "path": "/en/video-to-sprite/"},
    {"id": "image-edit", "labelKey": "imageEdit", "path": "/en/tools/image-edit/"},
    {"id": "character-sheet", "labelKey": "characterSheet", "path": "/en/tools/character-sheet/"},
    {"id": "portrait-edit", "labelKey": "portraitEdit", "path": "/en/tools/portrait-edit/"},
    {"id": "bust-enhancer", "labelKey": "bustEnhancer", "path": "/en/tools/bust-enhancer/"},
    {"id": "face-swap", "labelKey": "faceSwap", "path": "/en/tools/face-swap/"},
    {"id": "logo-generator", "labelKey": "logoGenerator", "path": "/en/tools/ai-logo-generator/"},
    {"id": "video-compress", "labelKey": "videoCompress", "path": "/en/tools/video-compress/"},
    {"id": "video-to-sprite", "labelKey": "videoToSprite", "path": "/en/tools/video-to-sprite/"},
    {"id": "subtitles", "labelKey": "subtitles", "path": "/en/tools/subtitles/"},
    {"id": "subtitle-translation", "labelKey": "subtitleTranslation", "path": "/en/tools/subtitle-translation/"}
  ],
  "targets": { "performance": 90, "accessibility": 100, "seo": 95, "lcpMs": 2500, "cls": 0.1, "tbtMs": 200 },
  "critical": { "performance": 70, "accessibility": 90, "seo": 85, "lcpMs": 4000, "cls": 0.25, "tbtMs": 600 }
}
